#!/bin/sh
# Runs the test suite before every push, so the gate holds even when GitHub Actions
# minutes have run out. Turn it on once per clone with `npm run hooks`.
# Skip for one push with `git push --no-verify`.
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-push: running the tests (git push --no-verify skips this)"
npm test >/tmp/ob-pre-push.log 2>&1
status=$?
if [ $status -ne 0 ]; then
  tail -40 /tmp/ob-pre-push.log
  echo "pre-push: tests failed (exit $status), push refused"
  exit $status
fi
grep -E '^ℹ (tests|pass|fail) ' /tmp/ob-pre-push.log
exit 0
